# Rust
/target/
**/*.rs.bk

# Build and distribution output
/dist/
/build/
/out/
*.jar.tmp

# Runtime state: never commit a world, player database or log
/config/
/data/
/logs/
/plugins/*.jar
/native/

# Local toolchains used for building (not part of the project)
/.toolchain/
/.jdk/

# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store

# Release archives are built by scripts/bundle.sh / CI and attached to GitHub
# releases; they are never committed. A locally verified copy may exist in
# releases/ for convenience.
/releases/
