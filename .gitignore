# Rust
/target/
**/*.rs.bk

# Build and distribution output
/dist/
/build/
/out/
*.jar.tmp

# Runtime state: never commit a world, player database or log
/config/
/data/
/logs/
/plugins/*.jar
/native/

# Local toolchains used for building (not part of the project)
/.toolchain/
/.jdk/

# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store

# Release artifacts are built by CI and attached to GitHub releases. The copy in
# releases/ is committed on purpose: it is the verified build for the current
# tag, so `java -jar` works from a fresh clone without a toolchain.
/releases/*.tmp
